@echo off
chcp 936 >nul
title 把电脑声音推给 ESP32 板子(USB / Type-C)

:: ============================================================
::  板子当"USB 音箱"用 —— 走 Type-C 线,不经 WiFi。
::
::  双击本文件 -> 板子开始放电脑里正在响的声音。
::  然后你照常打开网易云音乐放歌就行,声音会从板子出来。
::
::  Ctrl+C 停止。
::
::  【和 WiFi 版的区别】
::    - 延迟明显更低。WiFi 那条路上 16KB 的 TCP 接收窗口本身
::      就是约 85ms 的在途数据,再叠上为抗抖动做大的 I2S DMA,
::      端到端两百多毫秒;USB 不抖,板子那边 DMA 只用 42.7ms。
::    - 不用管板子连没连上 WiFi。
::    - 但【不能】和烧录同时用 —— 是同一条 Type-C 口。
::      要烧程序就先 Ctrl+C 退出本程序。
::    - 没有反向停止通道(停止推流那个命令只有 WiFi 会发),
::      所以退出只能按 Ctrl+C。
::
::  前提:板子开着机,用【数据线】接在电脑上(不是只能充电的线)。
::        板子会自动接管喇叭并把频谱源切到"电脑推流"。
:: ============================================================

set "WASCAP=%~dp0wascap\wascap.exe"
if not exist "%WASCAP%" (
    echo.
    echo   [X] 找不到 %WASCAP%
    echo       先在 wascap 目录里跑一下 build.bat 编译。
    echo.
    pause
    exit /b 1
)

echo.
echo   正在找板子的 Type-C 串口并开始采集电脑声音 ...
echo   现在可以去放网易云音乐了。Ctrl+C 停止。
echo.
"%WASCAP%" --usb

echo
echo   ---- 已停止 ----
pause
