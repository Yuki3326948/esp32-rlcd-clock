#pragma once

/* ============================================================
 *  默认 WiFi 凭据 —— 模板文件
 * ============================================================
 *
 *  怎么用
 *      把本文件复制成同目录下的 `wifi_secrets.h`,然后把下面两行
 *      改成自己的 WiFi,重新编译烧录。开机就会自动连上,不用插 TF 卡。
 *
 *  不建这个文件会怎样
 *      也能正常编译。凭据是空的,屏幕左上角显示 `no wifi`,
 *      这时**在 TF 卡根目录放一个 wifi.txt** 就能配网
 *      (见 docs/WiFi配置说明.md),而且 TF 卡里的配置优先级更高,
 *      会覆盖这里写死的值。
 *
 *  ⚠️ 为什么单独一个文件
 *      `wifi_secrets.h` 被写进了 .gitignore,**不会**进版本库。
 *      如果你的密码写在 user_app.cpp 里,一旦提交上去,即使以后删掉,
 *      它也永远留在这条 git 历史里(git log -p 谁都能翻出来)。
 *      所以真实凭据必须从一开始就放在这个不进库的文件里。
 *
 *  ⚠️ 编"给别人用"的固件
 *      即使用了本文件,也可以用下面这个开关强制留空,双保险:
 *          idf.py -DWIFI_CREDENTIALS_EMPTY=ON build
 *
 *  注意:SSID 上限 32 字节,密码上限 64 字节(802.11 的硬限制)。
 */

#define WIFI_SSID        "你的WiFi名字"
#define WIFI_PASSWORD    "你的WiFi密码"

/* ============================================================
 *  固定 IP(可选,默认关闭)
 * ============================================================
 *
 *  不定义这 6 个数 -> 走 DHCP,和普通设备一样。
 *  **公开仓库的默认就是这个**,所以克隆下来直接编译就能用。
 *
 *  想让板子用固定地址(比如电脑端的推流程序要按地址连过来),
 *  就把下面 6 行取消注释改成自己的网段。
 *
 *  为什么放在这个文件里而不是源码里:
 *    固定地址是【按具体网络】写的,而这属于个人环境信息。
 *    放在这个不进版本库的文件里,既不会漏出去,
 *    也不用每次编译都记得加命令行参数。
 *
 *  ⚠️ 地址别落在路由器的 DHCP 池里,否则可能和别的设备撞车
 *     (路由器分地址时不会考虑已经在用的人)。
 */

// #define STATIC_IP_0      192
// #define STATIC_IP_1      168
// #define STATIC_IP_2      1
// #define STATIC_IP_3      182
// #define STATIC_GW_0      192
// #define STATIC_GW_1      168
// #define STATIC_GW_2      1
// #define STATIC_GW_3      1
